+# SPDX-License-Identifier: BSD-2-Clause
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+from importlib.machinery import EXTENSION_SUFFIXES
+
+from sipbuild.buildable import BuildableModule
+
+
+class BuildableABI(unittest.TestCase):
+    def test_limited_api_target(self):
+        cases = [
+            (None, (3, 13, 0), False, True),
+            (0, (3, 13, 0), False, True),
+            (1, (3, 13, 0), False, False),
+            (1, (3, 13, 0), True, False),
+            (1, (3, 15, 0), False, True),
+            (1, (3, 15, 0), True, True),
+            (0, (3, 15, 0), True, True),
+        ]
+        for free_threaded, minimum, gil_disabled, limited in cases:
+            with self.subTest(target=free_threaded, minimum=minimum, gil=gil_disabled):
+                with tempfile.TemporaryDirectory() as directory:
+                    project = SimpleNamespace(build_dir=directory, sip_module='test.sip',
+                        limited_abi_version=minimum, py_platform='linux')
+                    with patch('sysconfig.get_config_var', return_value=free_threaded):
+                        module = BuildableModule(project, 'module', 'test.module',
+                            uses_limited_api=True, gil_disabled=gil_disabled)
+                    self.assertEqual(module.uses_limited_api, limited)
+                    self.assertEqual(module.gil_disabled, gil_disabled)
+                    expected = []
+                    if limited:
+                        version = '0x%02x%02x%02x00' % minimum
+                        expected.append('Py_LIMITED_API=' + version)
+                        if gil_disabled and minimum >= (3, 15, 0):
+                            expected.append('Py_TARGET_ABI3T=' + version)
+                    self.assertEqual(module.define_macros, expected)
+                    if not limited:
+                        self.assertEqual(module.get_module_extension(), EXTENSION_SUFFIXES[0])
+
+
+if __name__ == '__main__':
+    unittest.main()
