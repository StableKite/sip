From: Phil Thompson <phil@riverbankcomputing.com>
Date: Thu, 5 May 2022 15:49:32 +0100
Subject: Tweak the code generated for catching exceptions so that is matches
 older SIP versions.

---
 code_generator/gencode.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/code_generator/gencode.c b/code_generator/gencode.c
index 55f5af8..3c52836 100644
--- a/code_generator/gencode.c
+++ b/code_generator/gencode.c
@@ -10674,8 +10674,12 @@ static void generateCatchBlock(moduleDef *mod, exceptionDef *xd,
 {
     scopedNameDef *ename = xd->iff->fqcname;
 
+    /*
+     * The global scope is stripped from the exception name to be consistent
+     * with older versions of SIP.
+     */
     prcode(fp,
-"            catch (%S &%s)\n"
+"            catch (%V &%s)\n"
 "            {\n"
         ,ename,(xd->cd != NULL || usedInCode(xd->raisecode, "sipExceptionRef")) ? "sipExceptionRef" : "");
 
