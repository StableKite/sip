#!/bin/sh

set -eu

cd "$AUTOPKGTEST_TMP"

for py in $(py3versions -s); do
    for interpreter in "$py" "$py-dbg"; do
        echo "testing $interpreter"
        "$interpreter" - <<'PY'
import sys

before = sys._is_gil_enabled()
from PyQt6 import sip

assert sip.SIP_ABI_VERSION >> 16 == 14, sip.SIP_ABI_VERSION
assert sys._is_gil_enabled() == before
PY
    done
done
