+# SPDX-License-Identifier: BSD-2-Clause
+
+import json
+import os
+from pathlib import Path
+import sys
+
+import pytest
+import sipbuild
+
+from conftest import _run_python
+
+
+@pytest.mark.parametrize('inherited_path', [False, True])
+def test_build_subprocess_uses_tested_sip(tmp_path, monkeypatch, inherited_path):
+    """ Changing the build directory must not select a system-installed SIP. """
+
+    output = tmp_path / 'provenance.json'
+    inherited = str(tmp_path / 'inherited')
+    monkeypatch.chdir(tmp_path)
+    if inherited_path:
+        monkeypatch.setenv('PYTHONPATH', inherited)
+    else:
+        monkeypatch.delenv('PYTHONPATH', raising=False)
+
+    probe = (
+        'import json, pathlib, sipbuild, sys; '
+        'pathlib.Path(sys.argv[1]).write_text(json.dumps('
+        '{"sip": sipbuild.__file__, "paths": sys.path}))'
+    )
+    _run_python([sys.executable, '-c', probe, str(output)])
+    actual = json.loads(output.read_text())
+    assert Path(actual['sip']).resolve() == Path(sipbuild.__file__).resolve()
+    if inherited_path:
+        assert inherited in actual['paths']
+        assert os.environ['PYTHONPATH'] == inherited
+    else:
+        assert 'PYTHONPATH' not in os.environ
